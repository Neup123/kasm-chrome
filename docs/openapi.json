                "default": 15000
              },
              "container": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Exact, unambiguous Firefox contextual-identity name."
              },
              "tabId": {
                "type": "integer",
                "minimum": 0
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "Standard CSS selector; actions require exactly one match."
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120000,
                "default": 120000
              }
            },
            "required": [
              "cmd",
              "container",
              "tabId"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "const": "tabs.eval"
              },
              "id": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "description": "Unique request ID; generated when omitted. Accepted IDs are retained for 15 minutes to reject replay."
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 60000,
                "default": 15000
              },
              "container": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Exact, unambiguous Firefox contextual-identity name."
              },
              "tabId": {
                "type": "integer",
                "minimum": 0
              },
              "probe": {
                "type": "string",
                "enum": [
                  "page",
                  "elements",
                  "storage"
                ],
                "description": "Packaged diagnostics only. No arbitrary JavaScript evaluation."
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "Standard CSS selector; actions require exactly one match."
              }
            },
            "required": [
              "cmd",
              "container",
              "tabId",
              "probe"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "probe": {
                      "const": "elements"
                    }
                  }
                },
                "then": {
                  "required": [
                    "selector"
                  ]
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "const": "tabs.click"
              },
              "id": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "description": "Unique request ID; generated when omitted. Accepted IDs are retained for 15 minutes to reject replay."
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 60000,
                "default": 15000
              },
              "container": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Exact, unambiguous Firefox contextual-identity name."
              },
              "tabId": {
                "type": "integer",
                "minimum": 0
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "Standard CSS selector; actions require exactly one match."
              }
            },
