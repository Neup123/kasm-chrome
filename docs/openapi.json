              },
              "container": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Exact, unambiguous Firefox contextual-identity name."
              },
              "tabId": {
                "type": "integer",
                "minimum": 0
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "description": "Standard CSS selector; actions require exactly one match."
              },
              "text": {
                "type": "string",
                "maxLength": 64000
              },
              "clear": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "cmd",
              "container",
              "tabId",
              "text",
              "selector"
            ]
          }
        ]
