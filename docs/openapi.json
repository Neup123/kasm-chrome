{
  "openapi": "3.1.0",
  "info": {
    "title": "Kasm Firefox Agent Driver",
    "version": "0.1.0",
    "description": "Server-to-server API for named Firefox containers. WebSocket, fixtures and health endpoints are private and are not part of this routed API. All commands require a separate API key. Browser Origin headers are refused."
  },
  "servers": [
    {
      "url": "/agent-driver/v1"
    }
  ],
  "security": [
    {
      "DriverKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "DriverKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Command": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "const": "containers.ensure"
              },
              "id": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "description": "Unique request ID; generated when omitted. Accepted IDs are retained for 15 minutes to reject replay."
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 60000,
                "default": 15000
              },
              "container": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Exact, unambiguous Firefox contextual-identity name."
              },
              "color": {
                "type": "string",
                "enum": [
                  "blue",
                  "turquoise",
                  "green",
                  "yellow",
                  "orange",
                  "red",
                  "pink",
                  "purple",
                  "toolbar"
                ]
              },
              "icon": {
                "type": "string",
                "enum": [
                  "fingerprint",
                  "briefcase",
                  "dollar",
                  "cart",
                  "circle",
                  "gift",
                  "vacation",
                  "food"
                ]
              }
            },
            "required": [
              "cmd",
              "container"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "const": "containers.list"
              },
              "id": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "description": "Unique request ID; generated when omitted. Accepted IDs are retained for 15 minutes to reject replay."
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 60000,
                "default": 15000
              }
            },
            "required": [
              "cmd"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "const": "tabs.create"
              },
              "id": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "description": "Unique request ID; generated when omitted. Accepted IDs are retained for 15 minutes to reject replay."
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 60000,
                "default": 15000
              },
              "container": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Exact, unambiguous Firefox contextual-identity name."
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 8192,
                "description": "Only https://chatgpt.com or http://driver:8080, without URL credentials."
              },
              "active": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "cmd",
              "container",
              "url"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
